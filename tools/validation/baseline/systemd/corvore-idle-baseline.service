[Unit]
Description=CORVORE clean-native idle resource baseline
After=local-fs.target
ConditionPathExists=!/var/lib/corvore/validation/idle-baseline/completed.json

[Service]
Type=oneshot
ExecStart=/usr/bin/python3 /opt/corvore/validation/baseline/idle_baseline.py --duration 120 --sample-interval 5
ExecStartPost=/usr/bin/systemctl --no-block start corvore-idle-baseline-shutdown.service
TimeoutStartSec=180
UMask=0077

Environment=PYTHONDONTWRITEBYTECODE=1

NoNewPrivileges=yes
PrivateNetwork=yes
PrivateTmp=yes
ProtectHome=yes
ProtectSystem=strict
ProtectKernelTunables=yes
ProtectControlGroups=yes

ReadWritePaths=/var/lib/corvore/validation/idle-baseline

StandardOutput=journal
StandardError=journal
